// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Postgres, not the template's default SQLite. Render's free disk is wiped
// on every deploy and restart, so a file-backed database silently loses
// every merchant's settings — fine while testing, not something a paying
// merchant would forgive. DATABASE_URL is set in the hosting environment
// and must never be committed.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One row per shop. Everything a merchant toggles on the "Hooks" settings
// page lives here.
model HookSettings {
  id      String @id @default(cuid())
  shop    String @unique

  lowStockEnabled       Boolean @default(true)
  lowStockThreshold     Int     @default(5)

  readyToShipEnabled    Boolean @default(true)

  saleCountdownEnabled  Boolean  @default(false)
  saleEndsAt            DateTime?
  saleMessage           String   @default("Sale ends in")

  freeShippingEnabled   Boolean @default(false)
  freeShippingMessage   String  @default("Free shipping today")

  soldRecentlyEnabled   Boolean @default(false)

  sellingFastEnabled    Boolean @default(false)
  sellingFastThreshold  Int     @default(10)

  recentPurchaseEnabled  Boolean @default(false)
  recentPurchaseDemoMode Boolean @default(false)

  viewerCountEnabled    Boolean @default(false)
  wishlistCountEnabled  Boolean @default(false)

  // How many badges a single product page may show at once, no matter how
  // many hooks are switched on above. A product plastered with eight badges
  // reads as an app doing marketing at the shopper; two or three reads as
  // the store telling them something. Three is the default for that reason.
  maxHooks Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Written by the orders/paid webhook if real order data is ever wired up.
// Unused today (every number is generated), kept for a future "real data"
// tier. Only a product id and a coarse city/region — no customer id, name
// or full address.
model OrderEvent {
  id         String   @id @default(cuid())
  shop       String
  productId  String
  city       String?
  region     String?
  occurredAt DateTime @default(now())

  @@index([shop, productId, occurredAt])
  @@index([shop, occurredAt])
}
